# ---------------------------------------------------------------------------
# MyArchive Downloader — configuração de exemplo
# Copie para `.env` e ajuste. Todas as chaves usam o prefixo MAD_.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
MAD_APP_NAME="MyArchive Downloader"
MAD_DEBUG=false
MAD_API_PREFIX=/api
# Lista separada por vírgulas
MAD_CORS_ORIGINS="*"
# Prefixo se atrás de um reverse proxy (ex.: /downloader)
MAD_ROOT_PATH=

# --- Armazenamento ---------------------------------------------------------
# Use um volume montado para persistir os ficheiros baixados
MAD_DATA_DIR=./data
MAD_DOWNLOADS_DIR=./data/downloads
MAD_CACHE_DIR=./data/cache
MAD_TEMP_DIR=./data/tmp

# --- HTTP ------------------------------------------------------------------
MAD_HTTP_TIMEOUT=30
MAD_HTTP_CONNECT_TIMEOUT=10
MAD_HTTP_MAX_CONNECTIONS=32
MAD_HTTP_VERIFY_TLS=true
# Proxy de saída (opcional) — ex.: http://user:pass@proxy:8080
# Útil quando o conteúdo é restringido geograficamente: o France TV só
# responde a quem está em França (o serviço devolve HTTP 451 com uma
# mensagem explícita). Configure aqui um proxy com IP francês.
MAD_PROXY_URL=
MAD_ROTATE_USER_AGENTS=true

# --- Downloader ------------------------------------------------------------
MAD_DOWNLOAD_CONCURRENCY=8
MAD_CHUNK_SIZE=1048576
MAD_MAX_RETRIES=5
MAD_RETRY_BACKOFF_BASE=1.5
MAD_DOWNLOAD_TIMEOUT=600
MAD_MAX_FILE_SIZE=8589934592
MAD_RESUME_ENABLED=true
# Dividir cada ficheiro em vários pedidos Range em paralelo.
# Essencial no YouTube: o CDN limita a taxa por ligação (~3 KB/s num stream
# único, ~4 MB/s com 8 ligações em paralelo).
MAD_PARALLEL_DOWNLOAD=true
# Abaixo deste tamanho não se abre paralelismo.
MAD_PARALLEL_MIN_SIZE=1048576
# Chunk mínimo por ligação (define quantas ligações são abertas).
MAD_PARALLEL_MIN_CHUNK_SIZE=524288

# --- Jobs ------------------------------------------------------------------
MAD_JOB_TTL_SECONDS=3600
MAD_MAX_CONCURRENT_JOBS=4

# --- FFmpeg ----------------------------------------------------------------
MAD_ENABLE_POSTPROCESS=true
MAD_FFMPEG_PATH=ffmpeg
MAD_FFPROBE_PATH=ffprobe
MAD_FFMPEG_TIMEOUT=1800
MAD_DEFAULT_CONTAINER=mp4

# --- Segurança -------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAD_API_KEY=
MAD_RATE_LIMIT_PER_MINUTE=60
# true permite descarregar de IPs privados (desactivar em produção!)
MAD_ALLOW_PRIVATE_URLS=false

# --- Cache -----------------------------------------------------------------
MAD_CACHE_ENABLED=true
MAD_CACHE_TTL_SECONDS=1800
